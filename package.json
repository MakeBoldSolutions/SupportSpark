{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','dist-static']) fs.rmSync(p,{recursive:true,force:true});\"",
    "build": "tsx script/build.ts",
    "start": "node script/start.cjs",
    "check": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "dev:static": "vite --config vite.config.static.ts",
    "build:static": "vite build --config vite.config.static.ts",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm test"
  },
